{
  "name": "@eyeo/rules-utils",
  "type": "module",
  "exports": {
    "./adblock/*": "./dist/adblock/*",
    "./adblockplus/*": "./dist/adblockplus/*"
  },
  "typesVersions": {
    "*": {
      "adblock/index/adblock.json": [
        "./dist/adblock/index.d.ts"
      ],
      "adblockplus/index/adblockplus.json": [
        "./dist/adblockplus/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node src/node/build.js && node src/node/build-types.js",
    "build:release": "npm run build",
    "build:types": "node src/node/build-types.js",
    "test": "vitest run --exclude test/end-to-end --reporter=verbose",
    "test:end-to-end": "vitest run --root test/end-to-end --reporter=verbose"
  },
  "dependencies": {
    "@eyeo/filterlists": "1.0.99"
  },
  "peerDependencies": {
    "@eyeo/webext-ad-filtering-solution": "*",
    "vitest": "4.1.5"
  }
}
