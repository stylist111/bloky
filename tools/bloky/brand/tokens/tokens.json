{
  "name": "Bloky Design System",
  "version": "1.0.0",
  "font": {
    "sans": "Inter",
    "mono": "JetBrains Mono",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "color": {
    "blue": {
      "50": "#EEF2FF",
      "100": "#DCE4FF",
      "200": "#B9C9FF",
      "300": "#8DA6FF",
      "400": "#5C7FFF",
      "500": "#2B59FF",
      "600": "#1F45E0",
      "700": "#1A37B3",
      "800": "#172E8A",
      "900": "#121F5C"
    },
    "ink": {
      "0": "#FFFFFF",
      "50": "#F4F5F8",
      "100": "#EDEFF3",
      "200": "#DDE1E8",
      "300": "#C4CAD4",
      "400": "#8A94A6",
      "500": "#6B7385",
      "600": "#4A5263",
      "700": "#2A3247",
      "750": "#1C2336",
      "800": "#141A2B",
      "900": "#0B1020"
    },
    "green": { "50": "#E7F7EE", "500": "#12A150", "700": "#0E7A3D" },
    "amber": { "50": "#FFF4E0", "500": "#F5A524", "700": "#9A5B00" },
    "red": { "50": "#FDECEC", "500": "#D93036", "700": "#B4232A" }
  },
  "semantic": {
    "light": {
      "bg-app": "#F4F5F8",
      "bg-surface": "#FFFFFF",
      "bg-subtle": "#EDEFF3",
      "border": "#DDE1E8",
      "border-strong": "#C4CAD4",
      "text-primary": "#0B1020",
      "text-secondary": "#4A5263",
      "text-tertiary": "#6B7385",
      "text-on-accent": "#FFFFFF",
      "accent": "#2B59FF",
      "accent-hover": "#1F45E0",
      "accent-subtle": "#EEF2FF",
      "accent-text": "#1F45E0",
      "state-paused": "#8A94A6",
      "state-unavailable": "#C4CAD4",
      "success-fill": "#12A150",
      "success-bg": "#E7F7EE",
      "success-text": "#0E7A3D",
      "warning-fill": "#F5A524",
      "warning-bg": "#FFF4E0",
      "warning-text": "#9A5B00",
      "danger-fill": "#D93036",
      "danger-bg": "#FDECEC",
      "danger-text": "#B4232A",
      "info-fill": "#2B59FF",
      "info-bg": "#EEF2FF",
      "info-text": "#1F45E0",
      "badge-bg": "#0B1020",
      "badge-text": "#FFFFFF"
    },
    "dark": {
      "bg-app": "#0B1020",
      "bg-surface": "#141A2B",
      "bg-subtle": "#1C2336",
      "border": "#2A3247",
      "border-strong": "#3A4359",
      "text-primary": "#F2F4F8",
      "text-secondary": "#B7BECB",
      "text-tertiary": "#8A94A6",
      "text-on-accent": "#FFFFFF",
      "accent": "#2B59FF",
      "accent-hover": "#5C7FFF",
      "accent-subtle": "#1A2550",
      "accent-text": "#8DA6FF",
      "state-paused": "#6B7385",
      "state-unavailable": "#4A5263",
      "success-fill": "#12A150",
      "success-bg": "rgba(18,161,80,0.16)",
      "success-text": "#4ADE80",
      "warning-fill": "#F5A524",
      "warning-bg": "rgba(245,165,36,0.16)",
      "warning-text": "#FBBF24",
      "danger-fill": "#D93036",
      "danger-bg": "rgba(217,48,54,0.16)",
      "danger-text": "#F87171",
      "info-fill": "#2B59FF",
      "info-bg": "#1A2550",
      "info-text": "#8DA6FF",
      "badge-bg": "#FFFFFF",
      "badge-text": "#0B1020"
    }
  },
  "type": {
    "display": {
      "size": 32,
      "lineHeight": 40,
      "weight": 700,
      "tracking": "-0.02em"
    },
    "stat": {
      "size": 40,
      "lineHeight": 44,
      "weight": 700,
      "tracking": "-0.02em",
      "numeric": "tabular-nums"
    },
    "title": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600,
      "tracking": "-0.01em"
    },
    "heading": { "size": 16, "lineHeight": 24, "weight": 600 },
    "body": { "size": 14, "lineHeight": 20, "weight": 400 },
    "label": { "size": 14, "lineHeight": 20, "weight": 500 },
    "small": { "size": 13, "lineHeight": 18, "weight": 400 },
    "caption": { "size": 12, "lineHeight": 16, "weight": 500 },
    "overline": {
      "size": 11,
      "lineHeight": 16,
      "weight": 600,
      "tracking": "0.06em",
      "transform": "uppercase"
    },
    "mono": {
      "family": "JetBrains Mono",
      "size": 13,
      "lineHeight": 18,
      "weight": 500
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": { "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 20, "full": 999 },
  "size": {
    "control": 40,
    "control-sm": 32,
    "switch": { "w": 40, "h": 24, "knob": 18 },
    "popup-width": 360,
    "icon-tile-radius-ratio": 0.21875
  },
  "shadow": {
    "overlay": "0 8px 24px rgba(11,16,32,0.12)",
    "focus": "0 0 0 2px surface, 0 0 0 4px accent"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "ease": "cubic-bezier(0.2,0.8,0.2,1)"
  },
  "toolbar": {
    "active": { "icon": "#2B59FF", "badge": "count" },
    "clean": { "icon": "#2B59FF", "badge": null },
    "paused": { "icon": "#8A94A6", "badge": null },
    "error": { "icon": "#2B59FF", "badge": "!", "badgeColor": "#D93036" },
    "unavailable": { "icon": "#C4CAD4", "badge": null }
  }
}
