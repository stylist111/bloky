{
  "name": "@eyeo-fragments/yt-wall-detection",
  "type": "module",
  "license": "GPL-3.0",
  "private": true,
  "typesVersions": {
    "*": {
      "background": [
        "./dist/background/index.d.ts"
      ],
      "content": [
        "./dist/content/index.d.ts"
      ]
    }
  },
  "files": [
    "./dist/"
  ],
  "exports": {
    "./background": "./dist/background/index.js",
    "./content": "./dist/content/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:release": "tsc --project tsconfig.json",
    "lint": "eslint --ext .ts src/",
    "prettier-fix": "prettier --write .",
    "test": "vitest run --reporter=verbose"
  },
  "peerDependencies": {
    "@eyeo/webext-ad-filtering-solution": "*"
  },
  "dependencies": {
    "@eyeo/polyfills": "*",
    "webextension-polyfill": "npm:@eyeo/webextension-polyfill",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "eslint": "8.34.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-standard-with-typescript": "39.1.1",
    "eslint-plugin-prettier": "5.1.3",
    "vitest": "2.1.3",
    "vitest-chrome": "0.1.0",
    "vitest-mock-extended": "2.0.2"
  }
}
