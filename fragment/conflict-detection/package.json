    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "prettier": "3.3.3",
    "vite": "5.4.11",
    "vitest": "3.0.9",
    "vitest-mock-extended": "2.0.2"
  }
