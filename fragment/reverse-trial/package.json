{
  "name": "@eyeo-fragments/reverse-trial",
  "type": "module",
  "license": "GPL-3.0",
  "private": true,
  "typesVersions": {
    "*": {
      "background": [
        "./dist/background/index.d.ts"
      ],
      "content": [
        "./dist/content/index.d.ts"
      ]
    }
  },
  "files": [
    "./dist/"
  ],
  "exports": {
    "./background": "./dist/background/index.js",
    "./content": "./dist/content/index.js",
    "./content/*": "./dist/content/*"
  },
  "scripts": {
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly",
    "build": "tsc --project tsconfig.json",
    "build:release": "tsc --project tsconfig.json",
    "test": "vitest run --reporter=verbose"
  },
  "peerDependencies": {
    "@eyeo/webext-ad-filtering-solution": "*",
    "webextension-polyfill": "*"
  },
  "dependencies": {
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "vitest": "3.0.9",
    "vitest-chrome": "0.1.0",
    "vitest-mock-extended": "2.0.2"
  }
}
