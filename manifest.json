{
  "name": "SDK test extension",
  "version": "0.0.1",
  "manifest_version": 2,
  "background": {
    "scripts": ["dist/abp-api.js", "background.js"]
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "dist/abp-content.js"
      ],
      "match_about_blank": true,
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "unlimitedStorage",
    "http://*/*",
    "https://*/*"
  ]
}
