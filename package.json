{
  "name": "extensions",
  "private": true,
  "description": "Extensions monorepo",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "core/*",
    "core/sdk/adblockpluscore",
    "fragment/*",
    "fragment/test/test-extension",
    "host/*",
    "public/*",
    "tools/*",
    "ui-components",
    "vendor/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "build:release": "lerna run build:release",
    "build:local": "lerna run build:local",
    "build:source": "lerna run build:source",
    "test": "lerna run test",
    "test:fragments": "lerna run test:fragments",
    "test:end-to-end": "lerna run test:end-to-end",
    "lint": "lerna run lint && prettier --check .",
    "lint-fix": "lerna run lint-fix && prettier --write .",
    "do-release": "npm run -w @eyeo/release-utils do-release --"
  },
  "devDependencies": {
    "babel-loader": "8.4.1",
    "eslint": "8.34.0",
    "eslint-config-prettier": "9.1.0",
    "lerna": "8.1.8",
    "prettier": "3.3.3",
    "rollup": "4.32.0",
    "selenium-webdriver": "4.23.0",
    "typescript": "4.7.3"
  }
}
