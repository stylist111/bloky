{
  "name": "@eyeo/webext-sdk",
  "version": "0.4.0",
  "description": "eyeo's Web Extension Ad Blocking Toolkit",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/eyeo/adblockplus/abc/webext-sdk"
  },
  "author": "eyeo GmbH",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=16.10.0",
    "npm": ">=7"
  },
  "type": "module",
  "main": "./dist/ewe-api.js",
  "exports": {
    ".": "./dist/ewe-api.js",
    "./content": "./dist/ewe-content.js",
    "./sdk/*": "./sdk/*"
  },
  "files": [
    "dist/*.js*",
    "RELEASE_NOTES.md",
    "scripts",
    "sdk",
    "webpack.config.js"
  ],
  "dependencies": {
    "adblockpluscore": "git+https://github.com/adblockplus/adblockpluscore.git#52f733aeee37736432f8c8e6da81aad156d20e67",
    "webextension-polyfill": "^0.8.0"
  },
  "devDependencies": {
    "@eyeo/get-browser-binary": "^0.2.0",
    "chromedriver": "^90.0.1",
    "copy-webpack-plugin": "^9.0.1",
    "css-loader": "^5.2.6",
    "documentation": "^13.2.5",
    "eslint": "^7.29.0",
    "eslint-config-eyeo": "^3.2.0",
    "eslint-plugin-html": "^6.1.2",
    "expect": "^25.5.0",
    "express": "^4.17.1",
    "geckodriver": "^3.0.2",
    "generate-json-webpack-plugin": "^2.0.0",
    "html-webpack-plugin": "^5.3.2",
    "mini-css-extract-plugin": "^2.0.0",
    "mocha": "^10.0.0",
    "msedgedriver": "^91.0.0",
    "on-headers": "^1.0.2",
    "selenium-webdriver": "^4.3.0",
    "sinon": "^11.1.1",
    "source-map-loader": "^3.0.0",
    "webpack": "^5.37.1",
    "webpack-cli": "^4.7.0",
    "ws": "^7.4.6",
    "yargs": "^17.0.1"
  },
  "scripts": {
    "lint": "eslint --ext js,html .",
    "docs": "documentation build --document-exported -f html -o docs --config documentation.yml sdk/api/index.js sdk/api/types.js",
    "build": "webpack",
    "start": "webpack -w",
    "prepublishOnly": "webpack",
    "test": "node test/runner.js",
    "test-server": "node test/start-server.js",
    "test-bundle": "node test/bundle/run.js",
    "test-scripts": "mocha test/scripts/*.js",
    "measureTestFlakiness": "node scripts/measureTestFlakiness.js",
    "subs-init": "npm exec updateSubscriptions -- -t mv3",
    "subs-merge": "npm exec mergeSubscriptions -- -i build/data/subscriptions_mv3.json -o ./custom-subscriptions.json",
    "subs-fetch": "npm exec fetchSubscriptions -- -i ./custom-subscriptions.json",
    "subs-convert": "node scripts/convertSubscriptions.js -i build/data/subscriptions/ABP/",
    "subs-generate": "node scripts/generateSubscriptionsFragment.js",
    "create-allowlisting-keypair": "node scripts/createKeypair.js"
  },
  "bin":
  {
    "convertSubscriptions": "./scripts/convertSubscriptions.js",
    "generateSubscriptionsFragment": "./scripts/generateSubscriptionsFragment.js"
  }
}
