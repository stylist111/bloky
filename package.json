{
  "name": "extensions",
  "private": true,
  "description": "Extensions monorepo",
  "workspaces": [
    "host/*",
    "fragment/*",
    "fragment/test/test-extension",
    "core/*",
    "core/sdk/adblockpluscore",
    "ui-components",
    "test-utils",
    "scripts/*",
    "vendor/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "build:release": "lerna run build:release",
    "build:local": "lerna run build:local",
    "build:source": "lerna run build:source",
    "test": "lerna run test",
    "test:end-to-end": "lerna run test:end-to-end",
    "lint": "lerna run lint",
    "do-release": "npm run -w scripts/release-utils do-release --"
  },
  "devDependencies": {
    "eslint": "8.34.0",
    "lerna": "8.1.8",
    "prettier": "3.3.3",
    "rollup": "4.32.0",
    "babel-loader": "8.4.1",
    "selenium-webdriver": "4.23.0",
    "typescript": "4.7.3"
  }
}
