{
  "name": "extensions",
  "private": true,
  "description": "Extensions monorepo",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "core/*",
    "core/sdk/adblockpluscore",
    "fragment/fragments/*",
    "fragment/test",
    "host/*",
    "public/*",
    "tools/*",
    "vendor/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "build:release": "lerna run build:release",
    "build:local": "lerna run build:local",
    "build:source": "lerna run build:source",
    "test": "lerna run test",
    "test:fragments": "lerna run test:fragments",
    "test:end-to-end": "lerna run test:end-to-end",
    "eslint": "eslint --ext .js,.mjs,.cjs,.ts,.html --ignore-path .gitignore .",
    "lint": "lerna run lint && npm run eslint && prettier --check .",
    "lint-fix": "lerna run lint-fix && npm run eslint -- --fix && prettier --write .",
    "do-release": "npm run -w @eyeo/release-utils do-release --"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "babel-loader": "8.4.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-eyeo": "3.2.0",
    "eslint-config-love": "44.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-html": "6.2.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-mocha": "10.5.0",
    "eslint-plugin-n": "16.2.0",
    "eslint-plugin-no-unsanitized": "4.0.2",
    "eslint-plugin-promise": "6.1.1",
    "lerna": "9.0.7",
    "mocha": "10.8.2",
    "prettier": "3.3.3",
    "selenium-webdriver": "4.23.0",
    "typescript": "5.5.4",
    "vite": "6.4.2",
    "vitest": "4.1.5",
    "vitest-chrome": "0.1.0",
    "vitest-mock-extended": "2.0.2"
  },
  "overrides": {
    "lerna": {
      "nx": {
        "axios": "1.16.1"
      }
    },
    "mocha": {
      "serialize-javascript": "7.0.5"
    }
  }
}
