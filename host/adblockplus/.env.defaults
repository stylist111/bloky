# These can either be filled in here (don't check them in, they're secret!)  or
# set as environment variables. They are set in the CI environment using Gitlab
# secrets.
# CDP
CDP_PING_URL=""
CDP_PUBLIC_KEY_URL=""
CDP_BEARER=""
# Eyeometry MAC counting
EYEOMETRY_URL=""
EYEOMETRY_BEARER=""
# Eyeometry event logging
EYEOMETRY_EVENT_LOGGING_URL=""
EYEOMETRY_EVENT_LOGGING_BEARER=""
# Sentry
SENTRY_DSN=""
# Use "development" for debugging purposes to not pollute Sentry logs
SENTRY_ENVIRONMENT="development"
