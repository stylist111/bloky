{
  "name": "adblock",
  "private": true,
  "description": "AdBlock",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/adblockinc/ext/adblock/adblock.git"
  },
  "author": "Adblock, Inc. Team",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://gitlab.com/adblockinc/ext/adblock/adblock/issues"
  },
  "homepage": "https://gitlab.com/adblockinc/ext/adblock/adblock/-/blob/main/README.md",
  "scripts": {
    "$": "npm-dollar",
    "build": "npm run $ build.devenv",
    "build:release": "npm run $ build.release",
    "build:source": "gulp source",
    "html-hint": "npm run $ lint.html",
    "json-bundle": "node build/jsonBundle.cjs",
    "lint": "npm run $ lint",
    "sentry:login": "sentry-cli login",
    "sentry:release-new": "sentry-cli releases new $VERSION --org eyeo --project adblock",
    "sentry:release-finalize": "sentry-cli releases finalize $VERSION --org eyeo --project adblock",
    "sentry:sourcemaps": "sentry-cli sourcemaps upload --release=$VERSION --org eyeo --project adblock ./dist/sourcemaps/chrome-mv3",
    "test": "vitest run ./src/ ./test/unit/",
    "test:watch": "vitest test/unit",
    "test:end-to-end": "npm run $ test.end-to-end",
    "test:end-to-end-local": "node test/end-to-end/runTests.js"
  },
  "$": {
    "build": {
      "devenv": {
        "chrome": {
          "mv2": "if [[ -z \"$1\" || \"$1\" == \"chrome\" && \"$2\" != \"3\" ]]; then $ create.devenv chrome 2; fi",
          "mv3": "if [[ -z \"$1\" || \"$1\" == \"chrome\" && \"$2\" != \"2\" ]]; then $ create.devenv chrome 3; fi"
        },
        "firefox": "if [[ -z \"$1\" || \"$1\" == \"firefox\" ]]; then $ create.devenv firefox 2; fi"
      },
      "release": {
        "chrome": {
          "mv2": "if [[ -z \"$1\" || \"$1\" == \"chrome\" && \"$2\" != \"3\" ]]; then $ create.release chrome 2; fi",
          "mv3": "if [[ -z \"$1\" || \"$1\" == \"chrome\" && \"$2\" != \"2\" ]]; then $ create.release chrome 3; fi"
        },
        "firefox": "if [[ -z \"$1\" || \"$1\" == \"firefox\" ]]; then $ create.release firefox 2; fi"
      }
    },
    "create": {
      "devenv": "gulp devenv -t $1 -m $2 --unhandled-rejections=strict",
      "release": "gulp build -c release -t $1 -m $2 --unhandled-rejections=strict"
    },
    "lint": {
      "html": "htmlhint adblock-betafish/ -R ./rules/",
      "ts": "tsc --noEmit"
    },
    "test": {
      "end-to-end": {
        "chromium": {
          "mv2": "if [[ -z \"$1\" || \"$1\" == \"chromium\" && \"$2\" != \"3\" ]]; then MANIFEST_VERSION=2 BROWSER=chromium npm run test:end-to-end-local; fi",
          "mv3": "if [[ -z \"$1\" || \"$1\" == \"chromium\" && \"$2\" != \"2\" ]]; then MANIFEST_VERSION=3 BROWSER=chromium npm run test:end-to-end-local; fi"
        },
        "firefox": {
          "mv2": "if [[ -z \"$1\" || \"$1\" == \"firefox\" && \"$2\" != \"3\" ]]; then MANIFEST_VERSION=2 BROWSER=firefox npm run test:end-to-end-local; fi",
          "mv3": "if [[ -z \"$1\" || \"$1\" == \"firefox\" && \"$2\" == \"3\" ]]; then echo \"Firefox tests are not supported with extension in Manifest v3\"; exit 1; fi"
        },
        "edge": {
          "mv2": "if [[ -z \"$1\" || \"$1\" == \"edge\" && \"$2\" != \"3\" ]]; then MANIFEST_VERSION=2 BROWSER=edge npm run test:end-to-end-local; fi",
          "mv3": "if [[ -z \"$1\" || \"$1\" == \"edge\" && \"$2\" == \"3\" ]]; then MANIFEST_VERSION=3 BROWSER=edge npm run test:end-to-end-local; fi"
        },
        "chrome": {
          "mv3": "if [[ -z \"$1\" || \"$1\" == \"chrome\" && \"$2\" != \"2\" ]]; then MANIFEST_VERSION=3 BROWSER=chrome npm run test:end-to-end-local; fi"
        }
      }
    }
  },
  "peerDependencies": {
    "typescript": "5.5.4"
  },
  "devDependencies": {
    "@babel/core": "7.26.7",
    "@babel/preset-env": "7.26.0",
    "@babel/preset-typescript": "7.26.0",
    "@eyeo/get-browser-binary": "0.24.1",
    "@eyeo/test-utils": "*",
    "@rollup/plugin-commonjs": "22.0.2",
    "@rollup/plugin-node-resolve": "13.3.0",
    "@sentry/cli": "2.37.0",
    "@tailwindcss/forms": "0.5.10",
    "@types/jest": "28.1.6",
    "adm-zip": "0.5.9",
    "chai": "4.3.6",
    "css-loader": "6.8.1",
    "dmg": "0.1.0",
    "dotenv-webpack": "8.1.0",
    "expect": "29.7.0",
    "gulp-gzip": "1.4.2",
    "gulp-replace": "1.1.4",
    "gulp-tar": "3.1.0",
    "through": "2.3.8",
    "handlebars": "4.7.9",
    "htmlhint": "1.1.4",
    "jsdom": "25.0.0",
    "mkdirp": "1.0.4",
    "mocha": "10.8.2",
    "ncp": "2.0.0",
    "rollup": "2.77.2",
    "rollup-plugin-license": "2.8.1",
    "rollup-plugin-node-polyfills": "0.2.1",
    "rollup-plugin-terser": "7.0.2",
    "script-loader": "0.7.2",
    "selenium-webdriver": "4.23.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "postcss-loader": "8.2.1",
    "source-map-loader": "4.0.0",
    "style-loader": "3.3.3",
    "tailwindcss": "3.4.17",
    "vite": "6.0.11",
    "vitest": "3.0.9"
  },
  "dependencies": {
    "@eyeo-fragments/close-tab": "*",
    "@eyeo-fragments/conflict-detection": "*",
    "@eyeo-fragments/cookie-banner-detection": "*",
    "@eyeo-fragments/debug-information": "*",
    "@eyeo-fragments/in-product-messaging": "*",
    "@eyeo-fragments/public-api": "*",
    "@eyeo-fragments/reverse-trial": "*",
    "@eyeo-fragments/yt-wall-detection": "*",
    "@eyeo/rules-utils": "*",
    "@eyeo/webext-ad-filtering-solution": "*",
    "@rollup/plugin-typescript": "8.3.2",
    "@types/dompurify": "3.0.2",
    "@types/webextension-polyfill": "0.12.0",
    "argparse": "1.0.10",
    "del": "7.0.0",
    "dompurify": "3.1.3",
    "got": "12.3.1",
    "gulp": "4.0.2",
    "gulp-vinyl-zip": "2.5.0",
    "merge-stream": "2.0.0",
    "merge2": "1.4.1",
    "npm-dollar": "2.2.1",
    "rollup-plugin-cleanup": "3.2.1",
    "ts-loader": "9.3.1",
    "uuid": "9.0.1",
    "vinyl-named": "1.1.0",
    "webextension-polyfill": "npm:@eyeo/webextension-polyfill",
    "webpack": "5.93.0",
    "webpack-merge": "6.0.1",
    "webpack-stream": "7.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist/devenv"
        ]
      },
      "build:release": {
        "outputs": [
          "{projectRoot}/dist/release"
        ]
      }
    }
  }
}
