# Prevents using packages that are incompatible with the given node version
engine-strict=true

# This is a fix for npm taking a long time to install GitLab npm dependencies
fetch-retries=0

# Prevents using package versions that were released in the last 30 days to give
# us some time to react, in case of malicious package versions from unpinned
# subdependencies
# Disabled for now, because we cannot use this option until npm provides us with
# a way to exclude our own packages (e.g. @eyeo/filterlists)
min-release-age=0

# Default to using exact package versions when running `npm install x`, rather
# than ones that auto-upgrade
save-exact=true

# Treat peer dependency mismatches/conflicts as install failures
strict-peer-deps=true
