{
  "extends": "eslint-config-eyeo",
  "root": true,
  "env": {
    "es2021": true
  },
  "plugins": [
    "eslint-plugin-html"
  ],
  "rules": {
    "curly": [
      "error",
      "multi-or-nest",
      "consistent"
    ],
    "max-len": [
      "error",
      {
        "ignoreUrls": true,
        "ignoreRegExpLiterals": true,
        "ignorePattern": "abp:subscribe"
      }
    ]
  },
  "parser": "babel-eslint",
  "parserOptions": {
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": [
        "background.js"
      ],
      "parserOptions": {
        "sourceType": "script"
      }
    }
  ]
}
