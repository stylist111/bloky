{
  "extends": "eslint-config-eyeo",
  "root": true,
  "env": {
    "browser": true,
    "webextensions": true
  },
  "parserOptions": {
    "ecmaVersion": 11
  },
  "rules": {
    "curly": ["error", "multi-or-nest", "consistent"]
  },
  "overrides": [
    {
      "files": ["./sdk/*"],
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      "files": ["webpack.config.js"],
      "env": {
        "node": true
      }
    }
  ]
}
