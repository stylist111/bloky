{
  "extends": [
    "eslint-config-eyeo"
  ],
  "root": true,
  "env": {
    "es2021": true
  },
  "plugins": [
    "eslint-plugin-html"
  ],
  "rules": {
    "brace-style": ["error", "stroustrup"],
    "curly": [
      "error",
      "multi-or-nest",
      "consistent"
    ],
    "max-len": [
      "error",
      {
        "ignoreUrls": true,
        "ignoreRegExpLiterals": true,
        "ignoreStrings": true,
        "ignoreTemplateLiterals": true,
        "ignorePattern": "abp:subscribe"
      }
    ]
  },
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": 2020
  },
  "overrides": [
    {
      "files": [
        "background.js",
        "index-options.js"
      ],
      "parserOptions": {
        "sourceType": "script"
      }
    }
  ]
}
