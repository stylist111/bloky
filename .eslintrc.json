{
  "extends": "eslint-config-eyeo",
  "root": true,
  "env": {
    "es2021": true
  },
  "rules": {
    "curly": [
      "error",
      "multi-or-nest",
      "consistent"
    ]
  },
  "overrides": [
    {
      "files": [
        "*.mjs"
      ],
      "parser": "babel-eslint",
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
